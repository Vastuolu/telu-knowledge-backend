# ==============================================================================
# TelU Knowledge Backend - Environment Variables
# ==============================================================================

# Port server backend (Default: 8000, port 3000 dialokasikan untuk frontend)
PORT=8000

# CORS: Daftar origin frontend yang diizinkan (pisahkan dengan koma jika multi-origin)
CORS_ORIGINS=http://localhost:3000

# ==============================================================================
# Swagger / OpenAPI Documentation
# ==============================================================================
# Opsional: Server URL di dokumentasi Swagger (tanpa /api). Kosongkan untuk menggunakan origin saat ini.
API_BASE_URL=
# Opsional: true/false untuk memaksa Swagger UI aktif/nonaktif. Kosongkan untuk aktif kecuali NODE_ENV=production.
ENABLE_SWAGGER=

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# URL project Supabase Anda
SUPABASE_URL=https://your-project.supabase.co
# Anon Public Key: Digunakan untuk alur autentikasi user (login, register, refresh, lupa password)
SUPABASE_ANON_KEY=your-anon-key-here
# Service Role Key: Digunakan HANYA untuk operasi admin/server terproteksi (update password user by ID, force signOut)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# Authentication & Verification Redirect URLs
# ==============================================================================
# URL pengalihan setelah mahasiswa mengklik tautan konfirmasi email pendaftaran
AUTH_EMAIL_REDIRECT_URL=http://localhost:3000/auth/callback
# URL pengalihan setelah mahasiswa mengklik tautan reset/pemulihan kata sandi di email
AUTH_RESET_REDIRECT_URL=http://localhost:3000/reset-password

# Domain email yang diizinkan untuk registrasi & login (Default: @student.telkomuniversity.ac.id)
ALLOWED_EMAIL_DOMAIN=@student.telkomuniversity.ac.id
