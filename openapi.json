    "/api/auth/login": {
      "post": {
        "description": "Login dengan email & password. Gunakan `data.access_token` pada tombol Authorize untuk endpoint yang butuh autentikasi.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validasi body gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "examples": {
                  "validation": {
                    "summary": "Validasi body gagal",
                    "value": {
                      "statusCode": 400,
                      "message": [
                        "email must be an email",
                        "password should not be empty"
                      ],
                      "isError": true,
                      "data": null
                    }
                  },
                  "emailDomain": {
                    "summary": "Domain email tidak valid",
                    "value": {
                      "statusCode": 400,
                      "message": "Email harus menggunakan domain @student.telkomuniversity.ac.id",
                      "isError": true,
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Kredensial tidak valid atau email belum diverifikasi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "examples": {
                  "invalidCredentials": {
                    "summary": "Email atau password salah",
                    "value": {
                      "statusCode": 401,
                      "message": "Email atau password salah",
                      "isError": true,
                      "data": null
                    }
                  },
                  "unconfirmedEmail": {
                    "summary": "Email belum diverifikasi",
                    "value": {
                      "statusCode": 401,
                      "message": "Email belum diverifikasi. Silakan periksa email Anda.",
                      "isError": true,
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Terlalu banyak permintaan (rate limit terlampaui)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "example": {
                  "statusCode": 429,
                  "message": "Terlalu banyak permintaan, silakan coba beberapa saat lagi.",
                  "isError": true,
                  "data": null
                }
              }
            }
          },
          "500": {
            "description": "Kesalahan tak terduga di server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "example": {
                  "statusCode": 500,
                  "message": "Internal server error",
                  "isError": true,
                  "data": null
                }
              }
            }
          }
        },
        "summary": "Login",
        "tags": [
          "Auth"
        ]
      }
    },
