    "/api/auth/register": {
      "post": {
        "description": "Mendaftar akun baru dengan email @student.telkomuniversity.ac.id. Tautan verifikasi akan dikirimkan ke email tersebut dan harus dikonfirmasi sebelum login.",
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registrasi berhasil diproses. User perlu memeriksa email untuk verifikasi akun.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validasi body gagal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "examples": {
                  "validation": {
                    "summary": "Validasi body gagal",
                    "value": {
                      "statusCode": 400,
                      "message": [
                        "Email harus menggunakan domain @student.telkomuniversity.ac.id",
                        "Password minimal 8 karakter"
                      ],
                      "isError": true,
                      "data": null
                    }
                  },
                  "emailDomain": {
                    "summary": "Domain email tidak valid",
                    "value": {
                      "statusCode": 400,
                      "message": "Email harus menggunakan domain @student.telkomuniversity.ac.id",
                      "isError": true,
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Terlalu banyak permintaan (rate limit terlampaui)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "example": {
                  "statusCode": 429,
                  "message": "Terlalu banyak permintaan, silakan coba beberapa saat lagi.",
                  "isError": true,
                  "data": null
                }
              }
            }
          },
          "500": {
            "description": "Kesalahan tak terduga di server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "example": {
                  "statusCode": 500,
                  "message": "Internal server error",
                  "isError": true,
                  "data": null
                }
              }
            }
          }
        },
        "summary": "Registrasi akun baru",
        "tags": [
          "Auth"
        ]
      }
    },
