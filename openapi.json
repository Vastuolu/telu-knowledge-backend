  "info": {
    "title": "Telu Knowledge API",
    "description": "REST API untuk platform Telu Knowledge. Autentikasi menggunakan access token Supabase (Bearer JWT) yang didapat dari endpoint login.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Masukkan access_token dari POST /api/auth/login"
      }
    },
    "schemas": {
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Pesan error"
          },
          "isError": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "nullable": true,
            "example": null
          }
        },
        "required": [
          "statusCode",
          "message",
          "isError",
          "data"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "mahasiswa@student.telkomuniversity.ac.id",
            "description": "Harus berdomain @student.telkomuniversity.ac.id"
          },
          "password": {
            "type": "string",
            "example": "rahasia123",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "0b6f1c2e-6a3d-4f7b-9a51-2f1e8c7d9a10"
          },
          "email": {
            "type": "string",
            "example": "mahasiswa@student.telkomuniversity.ac.id"
          },
          "created_at": {
            "type": "string",
            "example": "2026-10-31T12:00:00.000000Z"
          }
        },
        "required": [
          "id",
          "email",
          "created_at"
        ]
      },
      "AuthUserDataDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 201
          },
          "message": {
            "type": "string",
            "example": "Registrasi berhasil. Silakan periksa email Anda untuk verifikasi akun."
          },
          "isError": {
            "type": "boolean",
            "example": false
          },
          "data": {
            "$ref": "#/components/schemas/AuthUserDataDto"
          }
        },
        "required": [
          "statusCode",
          "message",
          "isError",
          "data"
        ]
      },
